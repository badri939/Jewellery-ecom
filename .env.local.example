# Copy to .env.local and fill in. Never commit .env.local.

# Strapi backend (server-only: never add a NEXT_PUBLIC_ prefix).
# Leave STRAPI_URL empty to build with the sample data in src/data/products.ts.
STRAPI_URL=
STRAPI_TOKEN=

# Fallbacks for fields left empty in Strapi's Store settings, and the live site address.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SITE_URL=
